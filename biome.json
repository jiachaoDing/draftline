{
  "files": {
    "includes": [
      "!!**/.openai/**",
      "src/**/*.ts",
      "src/**/*.tsx",
      "server/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "*.ts"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnreachable": "error",
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        }
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "openai",
                      "openai/**",
                      "ai",
                      "ai/**",
                      "@ai-sdk/**",
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "node:*",
                      "**/server/**"
                    ],
                    "message": "Keep provider SDKs, Node APIs and server modules in server/. Browser requests use src/lib/api.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
