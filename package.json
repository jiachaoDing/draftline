{
  "name": "draftline-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run check && npm test && npm run build",
    "verify:all": "npm run verify && npm run test:e2e",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@headlessui/react": "^2.2.10",
    "@hono/node-server": "2.1.4",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "eventsource-parser": "4.1.2",
    "hono": "4.13.13",
    "idb": "^8.0.4",
    "lucide-react": "1.55.0",
    "openai": "7.32.0",
    "partial-json": "0.1.7",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svg-pan-zoom": "3.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
